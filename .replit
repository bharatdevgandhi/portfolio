modules = ["nodejs-24", "python-base-3.13"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
deploymentTarget = "static"
publicDir = "artifacts/portfolio/dist/public"
build = ["bash", "-c", "BASE_PATH=/ PORT=3000 pnpm --filter @workspace/portfolio run build"]

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["github:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 21113
externalPort = 80

[[ports]]
localPort = 21114
externalPort = 3000
